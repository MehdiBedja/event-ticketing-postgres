pipeline {
    agent any

    // Database connection details are stored in Jenkins, not in the repository.
    // Create them under Manage Jenkins > Credentials:
    //   postgres-jdbc-url : "Secret text", e.g. jdbc:postgresql://<host>/<database>
    //   postgres-login    : "Username with password"
    environment {
        DB_URL = credentials('postgres-jdbc-url')
    }

    stages {
        stage('Flyway Migration') {
            steps {
                withCredentials([usernamePassword(credentialsId: 'postgres-login',
                                                  usernameVariable: 'DB_USER',
                                                  passwordVariable: 'DB_PASSWORD')]) {
                    // Windows agent
                    bat 'flyway -url=%DB_URL% -user=%DB_USER% -password=%DB_PASSWORD% migrate'
                }
            }
        }
    }
}
